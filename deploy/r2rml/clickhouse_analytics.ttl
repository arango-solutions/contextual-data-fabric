# R2RML mapping generated by r2g (source: clickhouse).
# Relational -> RDF for SPARQL->SQL pushdown (e.g. Ontop). No data movement.
# Concept IRIs: <urn:arango-sparql:concept#...>   Resource IRIs: <http://r2g.example/resource/...>

@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#QueryEvent>
    a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "query_events" ] ;
    rr:subjectMap [
        rr:template "http://r2g.example/resource/QueryEvent/{event_id}" ;
        rr:class <urn:arango-sparql:concept#QueryEvent> ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#eventId> ;
        rr:objectMap [ rr:column "event_id" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#accountId> ;
        rr:objectMap [ rr:column "account_id" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#occurredAt> ;
        rr:objectMap [ rr:column "event_date" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#feature> ;
        rr:objectMap [ rr:column "feature" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#queryCount> ;
        rr:objectMap [ rr:column "query_count" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate <urn:arango-sparql:concept#avgLatencyMs> ;
        rr:objectMap [ rr:column "avg_latency_ms" ; rr:datatype xsd:double ] ;
    ] .

